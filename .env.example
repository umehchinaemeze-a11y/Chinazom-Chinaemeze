# .env.example
# Copy this file to .env and fill in real values.
# NEVER commit .env or .env.local — they are in .gitignore.
# Only .env.example (with placeholders) is committed.

# PostgreSQL connection string.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD_HERE@localhost:5432/auth_system"

# Server-side pepper for SHA-256 hashing of verification codes.
# Used in /lib/crypto/token.ts ONLY — not for passwords (those use Argon2id).
# Generate with: openssl rand -hex 32
CODE_PEPPER="replace-with-a-random-32-byte-hex-string"

# Server-side pepper for SHA-256 hashing of password-reset tokens.
# Separate from CODE_PEPPER so the two hashing contexts are independent.
# Generate with: openssl rand -hex 32
TOKEN_PEPPER="replace-with-a-different-random-32-byte-hex-string"
